# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า ห้าม commit ไฟล์ .env (หัวข้อ 9.1)
# ค่าที่ว่างไว้จะถูกใช้ตั้งแต่เฟสที่ระบุ ยังไม่ต้องกรอกตอนนี้

# ---- ฐานข้อมูลในเครื่อง (Docker) ----
POSTGRES_USER=buildcheck
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=buildcheck
DATABASE_URL=postgresql://buildcheck:change_me_local_only@localhost:5432/buildcheck

# ---- เว็บ ----
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ---- Better Auth (เฟส 3) ----
# สร้างค่าลับด้วยคำสั่ง: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# ---- ล็อกอินด้วย Google (เฟส 3) ถ้าเว้นว่าง ระบบจะซ่อนปุ่ม Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- ส่งอีเมลด้วย Resend (เฟส 3) ถ้าเว้นว่าง ตอนพัฒนาระบบจะแสดงลิงก์ในหน้าจอ Terminal แทน ----
RESEND_API_KEY=
EMAIL_FROM=

# ---- ที่เก็บรูป (เฟส 4) ----
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# ---- Vercel Cron คำนวณราคากลางทุกคืน (เฟส 9) ----
CRON_SECRET=
