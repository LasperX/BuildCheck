{
  "name": "buildcheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/db/seed/index.ts",
    "db:verify": "tsx --env-file=.env src/db/verify.ts",
    "db:studio": "drizzle-kit studio",
    "admin:promote": "tsx --env-file=.env src/db/promote-admin.ts",
    "db:seed:samples": "tsx --env-file=.env src/db/seed/samples.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@hookform/resolvers": "7.0.3",
    "@react-email/components": "1.0.12",
    "@tanstack/react-query": "5.105.3",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  }
}
